{
	"name": "client:main",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"clean": "npm run clean-cache  &&  npm run clean-dist",
		"clean-cache": "rm -rf ./.parcel-cache/*",
		"clean-dist": "rm -rf ./static/main/*",
		"build": "npm run clean && parcel build",
		"watch": "parcel watch --no-hmr"
	},
	"targets": {
		"auth": {
			"source": "./src/auth.html",
			"distDir": "./static/main/auth",
			"publicUrl": "/static/main/auth"
		},
		"dev": {
			"source": "./src/dev.html",
			"distDir": "./static/main/dev",
			"publicUrl": "/static/main/dev"
		},
		"error": {
			"source": "./src/error.html",
			"distDir": "./static/main/error",
			"publicUrl": "/static/main/error"
		},
		"go": {
			"source": "./src/go.html",
			"distDir": "./static/main/go",
			"publicUrl": "/static/main/go"
		},
		"marketing": {
			"source": "./src/marketing.html",
			"distDir": "./static/main/marketing",
			"publicUrl": "/static/main/marketing"
		},
		"member": {
			"source": "./src/member.html",
			"distDir": "./static/main/member",
			"publicUrl": "/static/main/member"
		},
		"share.poem": {
			"source": "./src/share/poem.html",
			"distDir": "./static/main/share/poem",
			"publicUrl": "/static/main/share/poem"
		},
		"system": {
			"source": "./src/system.html",
			"distDir": "./static/main/system",
			"publicUrl": "/static/main/system"
		},
		"vendor": {
			"source": "./src/vendor.html",
			"distDir": "./static/main/vendor",
			"publicUrl": "/static/main/vendor"
		}
	},
	"parcel-reporter-prepare-cfml": {
		"nonce": {
			"expression": "#e4a( csp.nonce )#",
			"targets": []
		},
		"authority": {
			"expression": "#site.authority#",
			"targets": []
		}
	},
	"browserslist": "defaults",
	"devDependencies": {
		"@parcel/resolver-glob": "2.16.4",
		"@parcel/transformer-less": "2.16.4",
		"alpinejs": "3.15.2",
		"htmx.org": "2.0.8",
		"parcel": "2.16.4",
		"parcel-reporter-prepare-cfml": "file:./plugins/parcel-reporter-prepare-cfml"
	}
}
